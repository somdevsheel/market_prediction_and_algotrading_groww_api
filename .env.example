# Choose ONE auth method. Never commit the real .env.
# 1) Daily access token (expires every morning ~06:00 IST)
GROWW_ACCESS_TOKEN=
# 2) TOTP flow (recommended for unattended daily start): API key of TOTP type + TOTP secret (base32 from QR)
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# 3) API key + secret flow (requires daily approval on Groww Cloud API Keys page)
GROWW_API_SECRET=
