[Unit]
Description=Nifty quant dashboard/API on 127.0.0.1:8100
After=network-online.target

[Service]
WorkingDirectory=/home/somdevsheel/Algo Trading Strategies/Nifty Algo Trading Using Groww API
ExecStart=/usr/bin/python3 -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
